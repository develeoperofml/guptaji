{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|site.webmanifest|humans.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.webmanifest",
      "destination": "/site.webmanifest"
    },
    {
      "source": "/stranger-trips",
      "destination": "/stranger-trips.html"
    },
    {
      "source": "/stranger-trips/",
      "destination": "/stranger-trips.html"
    },
    {
      "source": "/trip/kasol-kheerganga",
      "destination": "/trip-kasol-kheerganga.html"
    },
    {
      "source": "/trip/kasol-kheerganga/",
      "destination": "/trip-kasol-kheerganga.html"
    },
    {
      "source": "/trip/mcleodganj-triund",
      "destination": "/trip-mcleodganj-triund.html"
    },
    {
      "source": "/trip/mcleodganj-triund/",
      "destination": "/trip-mcleodganj-triund.html"
    },
    {
      "source": "/trip/chopta-tungnath",
      "destination": "/trip-chopta-tungnath.html"
    },
    {
      "source": "/trip/chopta-tungnath/",
      "destination": "/trip-chopta-tungnath.html"
    },
    {
      "source": "/trip/jibhi-tirthan",
      "destination": "/trip-jibhi-tirthan.html"
    },
    {
      "source": "/trip/jibhi-tirthan/",
      "destination": "/trip-jibhi-tirthan.html"
    },
    {
      "source": "/trip/spiti-valley",
      "destination": "/trip-spiti-valley.html"
    },
    {
      "source": "/trip/spiti-valley/",
      "destination": "/trip-spiti-valley.html"
    }
  ]
}
